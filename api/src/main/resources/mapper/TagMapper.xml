<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ayun.mapper.TagMapper">
    <select id="findAll" resultType="com.ayun.entity.Tag">
        SELECT * FROM tags
    </select>
    
    <select id="findByPostId" resultType="com.ayun.entity.Tag">
        SELECT t.* FROM tags t
        JOIN post_tags pt ON t.id = pt.tag_id
        WHERE pt.post_id = #{postId}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO tags (name) VALUES (#{name})
    </insert>
    
    <delete id="deleteById">
        DELETE FROM tags WHERE id = #{id}
    </delete>
    
    <insert id="insertPostTag">
        INSERT INTO post_tags (post_id, tag_id) VALUES (#{postId}, #{tagId})
    </insert>
    
    <delete id="deletePostTags">
        DELETE FROM post_tags WHERE post_id = #{postId}
    </delete>
</mapper>
