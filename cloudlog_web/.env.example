# ============================================================
# CloudLog 前端环境变量模板
# 复制本文件为 .env 并按需修改（.env 不会被提交）
# ============================================================

# 后端接口地址：只作为 vite dev 代理的 target（vite.config.ts），浏览器侧请求走相对路径 /api/v1
VITE_APP_API_BASE_URL = http://127.0.0.1:8080

# MinIO 服务地址
VITE_APP_MINIO_ENDPOINT = http://127.0.0.1:9000

# MinIO 存储桶名称（与后端 minio.bucketName 保持一致）
VITE_APP_MINIO_BUCKET = cloudlog
