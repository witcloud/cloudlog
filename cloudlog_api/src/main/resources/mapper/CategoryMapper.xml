<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ayun.mapper.CategoryMapper">
    <!-- 公开口径：计数只认 published，草稿/定时的篇数与存在性不得经此接口外泄 -->
    <select id="findAll" resultType="com.ayun.entity.Category">
        SELECT c.*, (SELECT COUNT(*) FROM posts WHERE category_id = c.id AND status = 'published') as article_count
        FROM categories c
    </select>

    <!-- 管理端口径：含草稿、定时与已下线的全量计数。与上面公开口径分列两条查询，不共用参数 -->
    <select id="findAllWithAllCount" resultType="com.ayun.entity.Category">
        SELECT c.*, (SELECT COUNT(*) FROM posts WHERE category_id = c.id) as article_count
        FROM categories c
    </select>

    <!-- 删除前置校验用：同样是全量口径，草稿与定时文章一样挂在分类下 -->
    <select id="countPosts" resultType="int">
        SELECT COUNT(*) FROM posts WHERE category_id = #{categoryId}
    </select>

    <select id="findById" resultType="com.ayun.entity.Category">
        SELECT * FROM categories WHERE id = #{id}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(*) FROM categories
    </select>

    <select id="findByName" resultType="com.ayun.entity.Category">
        SELECT * FROM categories WHERE name = #{name}
    </select>
    
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO categories (name, description)
        VALUES (#{name}, #{description})
    </insert>
    
    <update id="update">
        UPDATE categories
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
        </set>
        WHERE id = #{id}
    </update>
    
    <delete id="deleteById">
        DELETE FROM categories WHERE id = #{id}
    </delete>
</mapper>
