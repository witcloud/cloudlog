<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ayun.mapper.CommentMapper">
    <resultMap id="CommentResultMap" type="com.ayun.entity.Comment">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="userId" column="user_id"/>
        <result property="content" column="content"/>
        <result property="parentId" column="parent_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
        <association property="user" javaType="com.ayun.entity.User">
            <id property="id" column="user_id"/>
            <result property="username" column="username"/>
            <result property="avatar" column="avatar"/>
        </association>
    </resultMap>

    <resultMap id="AdminCommentResultMap" type="com.ayun.model.vo.AdminCommentVO">
        <id property="id" column="id"/>
        <result property="postId" column="post_id"/>
        <result property="postTitle" column="post_title"/>
        <result property="content" column="content"/>
        <result property="parentId" column="parent_id"/>
        <result property="parentContent" column="parent_content"/>
        <result property="parentUsername" column="parent_username"/>
        <result property="status" column="status"/>
        <result property="hitWord" column="hit_word"/>
        <result property="createdAt" column="created_at"/>
        <association property="user" javaType="com.ayun.model.vo.AdminCommentVO$UserVO">
            <id property="id" column="user_id"/>
            <result property="username" column="username"/>
            <result property="avatar" column="avatar"/>
        </association>
    </resultMap>

    <select id="findByPostId" resultMap="CommentResultMap">
        SELECT c.*, u.username, u.avatar
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.post_id = #{postId} AND c.parent_id = 0 AND c.status = 'approved'
        ORDER BY c.created_at DESC
    </select>

    <!-- 一屏根评论的回复一次取回（服务层按 parentId 分组回填）。
         IN 里的每一项都是服务层传进来的根评论 ID，逐个 #{} 绑定，不拼用户可控内容 -->
    <select id="findRepliesByParentIds" resultMap="CommentResultMap">
        SELECT c.*, u.username, u.avatar
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.status = 'approved'
        AND c.parent_id IN
        <foreach collection="parentIds" item="parentId" open="(" separator="," close=")">
            #{parentId}
        </foreach>
        ORDER BY c.created_at ASC
    </select>

    <select id="findById" resultMap="CommentResultMap">
        SELECT c.*, u.username, u.avatar
        FROM comments c
        LEFT JOIN users u ON c.user_id = u.id
        WHERE c.id = #{id}
    </select>

    <select id="findLastCreatedAtByUserId" resultType="java.time.LocalDateTime">
        SELECT MAX(created_at) FROM comments WHERE user_id = #{userId}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO comments (post_id, user_id, content, parent_id, status, hit_word)
        VALUES (#{postId}, #{userId}, #{content}, #{parentId}, #{status}, #{hitWord})
    </insert>

    <delete id="deleteById">
        DELETE FROM comments WHERE id = #{id}
    </delete>

    <sql id="adminCommentColumns">
        SELECT c.id, c.post_id, c.parent_id, c.content, c.status, c.hit_word, c.created_at,
               p.title as post_title,
               u.id as user_id, u.username, u.avatar,
               pc.content as parent_content, pcu.username as parent_username
        FROM comments c
        LEFT JOIN posts p ON c.post_id = p.id
        LEFT JOIN users u ON c.user_id = u.id
        LEFT JOIN comments pc ON c.parent_id = pc.id
        LEFT JOIN users pcu ON pc.user_id = pcu.id
    </sql>

    <!-- 关键词按字面量匹配：% 与 _ 在 LIKE 模式串里是通配符、\ 是转义符，三个都要先摘掉，
         替换顺序与 ESCAPE 口径同 PostMapper 的 escapedKeyword（先转义 \ 自身，后两步新写入的 \ 才不会被二次转义） -->
    <sql id="escapedKeyword">
        REPLACE(REPLACE(REPLACE(#{keyword}, '\\', '\\\\'), '%', '\\%'), '_', '\\_')
    </sql>

    <select id="findAdminList" resultMap="AdminCommentResultMap">
        <include refid="adminCommentColumns"/>
        <where>
            <if test="status != null and status != ''">AND c.status = #{status}</if>
            <if test="keyword != null and keyword != ''">
                AND (c.content LIKE CONCAT('%', <include refid="escapedKeyword"/>, '%') ESCAPE '\\'
                     OR u.username LIKE CONCAT('%', <include refid="escapedKeyword"/>, '%') ESCAPE '\\'
                     OR p.title LIKE CONCAT('%', <include refid="escapedKeyword"/>, '%') ESCAPE '\\')
            </if>
        </where>
        ORDER BY c.created_at DESC
    </select>

    <select id="findRecent" resultMap="AdminCommentResultMap">
        <include refid="adminCommentColumns"/>
        ORDER BY c.created_at DESC
        LIMIT #{limit}
    </select>

    <select id="countByStatus" resultType="long">
        SELECT COUNT(*) FROM comments WHERE status = #{status}
    </select>

    <update id="updateStatus">
        UPDATE comments SET status = #{status} WHERE id = #{id}
    </update>

    <select id="countApprovedWithChildren" resultType="int">
        SELECT COUNT(*) FROM comments
        WHERE status = 'approved' AND (id = #{id} OR parent_id = #{id})
    </select>

    <delete id="deleteWithChildren">
        DELETE FROM comments WHERE id = #{id} OR parent_id = #{id}
    </delete>

    <delete id="deleteByPostId">
        DELETE FROM comments WHERE post_id = #{postId}
    </delete>
</mapper>
