# ============================================================
# CloudLog 容器部署的凭据与取值模板
# cp .env.example .env 后逐项填写。真实 .env 不入库（.gitignore 已忽略 .env 与 .env.*，只放行 .env.example）。
# docker-compose.yml 与 deploy/api/application-prod.yml 里的 ${...} 全部从这里取值。
# ============================================================

# ---------- MySQL ----------
# root 口令：只用于容器初始化与健康检查，后端不用它连库
MYSQL_ROOT_PASSWORD=change-me-root
# 建库名与后端专用账号（镜像入口脚本建库、授权，只授予这一个库）
MYSQL_DATABASE=cloudlog
MYSQL_USERNAME=cloudlog
MYSQL_PASSWORD=change-me-app

# ---------- Redis ----------
# 只在 compose 内部网络里可达，不对外发布端口；它存验证码、频控、阅读去重与 token 失效水位
REDIS_PASSWORD=change-me-redis

# ---------- SMTP（注册验证码与找回密码）----------
# 后端无条件装配 JavaMailSender，这几项留空会导致容器起不来，先填上再说
SMTP_HOST=smtp.qq.com
SMTP_PORT=587
SMTP_USERNAME=your_email@qq.com
# 邮箱服务商的「授权码」，不是登录密码
SMTP_PASSWORD=change-me-smtp

# ---------- JWT ----------
# 必须随机生成且不少于 32 字节：openssl rand -base64 48
# 签名算法由 JJWT 按密钥字节长度推导（≥32→HS256，≥48→HS384，≥64→HS512，business-model.md §5.5），
# 换密钥等于作废全部在存登录态
JWT_SECRET=replace-with-openssl-rand-base64-48

# ---------- MinIO（图片上传，可选）----------
# 落库的图片地址是 {MINIO_ENDPOINT}/{bucket}/{objectKey} 的绝对值，换值要回刷库（db-design.md §5.5）。
# 这一项同时被后端读写：填容器服务名 http://minio:9000 时上传链路可用，但浏览器解析不到这个名字，
# 图片直链打不开；填 http://127.0.0.1:9000 时浏览器能打开，后端容器内的 localhost 却不是宿主机。
# 本机自测要两边都通，就给它一个宿主机与容器内都能解析的名字（宿主 /etc/hosts 或本地 DNS），
# 正式上线填真实公网域名，两边天然一致。
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-minio-password-8chars-min
MINIO_BUCKET=cloudlog
# MinIO 自 2026-09 起停发免费 Docker 镜像：Docker Hub 的 minio/minio、minio/mc 已下架（实测 404），
# quay.io 上的同名仓库匿名拉取被拒。启用 --profile images 前，这里必须填你自己构建的镜像
# 或可信镜像源里的同名镜像；留空则回落到历史名字，拉取会失败
MINIO_IMAGE=
# 宿主端口；控制台 9001 用来手工把桶设成匿名只读（见 README 容器化一节）
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------- 对外与转发口径 ----------
# 站点唯一对外入口的宿主端口
WEB_PORT=80
# 是否采信 nginx 传来的 X-Forwarded-For。默认 true 的前提是：api 的 8080 不对外发布、
# nginx 以覆盖方式写这个头（两份配置都是这么写的）。前提一变就改回 false，
# 否则登录爆破计数与日额度会变成「换一个头换一个额度」
APP_TRUST_FORWARDED_FOR=true
