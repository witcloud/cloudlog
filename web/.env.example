# 后端接口基础地址
VITE_APP_API_BASE_URL = http://127.0.0.1:8080

# MinIO 服务地址
VITE_APP_MINIO_ENDPOINT = http://127.0.0.1:9005

# MinIO 存储桶名称
VITE_APP_MINIO_BUCKET = cloud-blog
